{
  "name": "astrojyothi-muhurtha-engine",
  "version": "1.0.0",
  "description": "AstroJyothi Vedic Muhurtha Engine — Production-grade REST API for 37 categories with bilingual Tamil/English output",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop astrojyothi-muhurtha",
    "pm2:restart": "pm2 restart astrojyothi-muhurtha",
    "pm2:logs": "pm2 logs astrojyothi-muhurtha",
    "pm2:monit": "pm2 monit",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "swisseph": "^0.5.17",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "eslint": "^10.6.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.62.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
